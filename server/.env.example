PORT=4000
CLIENT_URL=http://localhost:5173
# Локальная база: из docker-compose.yml или своя в pgAdmin (роль val, база val — см. docs/DATABASE.md). Для облачной БД вставьте строку подключения провайдера.
DATABASE_URL=postgres://val:val_dev_password@localhost:5432/val
# true — для облачных баз, требующих SSL (Neon, Supabase, Timeweb и т. п.)
DATABASE_SSL=false

# Секрет для подписи сессий. Минимум 32 символа. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Почта. Если SMTP_HOST пуст, письма не отправляются, а ссылки печатаются в консоль сервера (удобно для разработки).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=VAL <no-reply@val-league.ru>

# За nginx/прокси укажите 1 — чтобы лимиты попыток считались по IP пользователя.
# TRUST_PROXY=1
