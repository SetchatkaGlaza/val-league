{
  "name": "val-league",
  "version": "0.1.0",
  "private": true,
  "description": "VOLOGDA AMATEUR LEAGUE — платформа онлайн-турниров по CS2",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,yellow \"npm run dev -w client\" \"npm run dev -w server\"",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w client",
    "format": "prettier --write .",
    "db:up": "docker compose up -d db",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server --",
    "admin:make": "npm run admin:make -w server --",
    "smoke": "npm run smoke -w server",
    "test": "npm run test -w server"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "prettier": "^3.3.0"
  },
  "engines": {
    "node": ">=20"
  }
}
